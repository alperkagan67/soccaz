# Staging (Pilot): wie das Caddyfile, aber mit Zugangsschutz (Basic-Auth) und noindex. Nur über docker-compose.staging.yml eingebunden; Produktion nutzt weiter das Caddyfile.
# Benutzer und Passwort-Hash (bcrypt) stehen NUR in der Umgebung des Staging-Servers (STAGING_BASIC_AUTH_USER, STAGING_BASIC_AUTH_HASH), nie im Repository. Es gibt keinen Standardwert:
# fehlt eine der Variablen, verweigert schon docker compose (siehe docker-compose.staging.yml), und Caddy lehnt eine leere Angabe ebenfalls ab. Staging startet nie offen.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Zugangsschutz für alles außer:
	#  - /api/stripe/webhook: Stripe kann sich nicht anmelden; der Schutz dort ist die Signaturprüfung (STRIPE_CARD_WEBHOOK_SECRET) in der App.
	#  - /api/health: Zustandsabfrage ohne Daten (Überwachung, Gesundheitsprüfung).
	# ANNAHME (beim ersten Staging-Login belegen, Checkliste): der Google-Anmeldefluss (/api/auth/callback/google) braucht KEINE Ausnahme, weil der Browser die Zugangsdaten für denselben Ursprung bei jeder Anfrage und auch bei der Rückleitung von Google mitsendet.
#  Der alte Pfad /api/webhooks/stripe ist NICHT ausgenommen (auf Staging ist dort kein Endpunkt angelegt). Unter /api/stripe/ gibt es nur /api/stripe/webhook.
	@geschuetzt not path /api/stripe/webhook /api/health
	basic_auth @geschuetzt {
		{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
	}

	# Live-Kanäle (SSE) dürfen nicht gepuffert werden
	@sse path /api/lobby/*/events /api/spiele/*/events /api/spiele/stream
	handle @sse {
		reverse_proxy app:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy app:3000
	}
}
