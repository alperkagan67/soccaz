# Lokale Entwicklung. Kopieren nach ".env.local" und Werte eintragen.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/soccav2

# Anmeldung
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Zahlungen (ohne STRIPE_SECRET_KEY läuft lokal der Test-Anbieter, es fließt kein Geld)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_FEE_PERCENT=2.9
PAYMENT_FEE_FIXED_CENTS=30

# Benachrichtigungen (ohne Werte wird nur protokolliert)
RESEND_API_KEY=
EMAIL_FROM=Socaz <noreply@socaz.de>
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@socaz.de

# Betrieb
APP_URL=http://localhost:3100
JOB_SECRET=
ENABLE_SCHEDULER=0
SENTRY_DSN=
